# Server-only configuration. config/env.py reads this file first and .env.local
# second, and a real environment variable beats both. Values left empty here fall
# through to the defaults in config/settings.py, so a non-empty value in this file
# becomes the default for every deployment that does not override it.
#
# Never commit .env.local. Copy the keys you need out of this file into it.

# --- AI and catalogue search (server-only credentials) ---------------------
OPENAI_API_KEY=
# Use a model available to your account that supports Responses structured output.
OPENAI_MODEL=gpt-4.1
# Required on a public deployment: messages are moderated before they reach the
# model and replies before they are shown.
SOUNDBRIDGE_MODERATION_MODEL=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Deployment ------------------------------------------------------------
# Declaring a public origin is what turns this into a production deployment:
# DEBUG goes off, ALLOWED_HOSTS narrows to this host, and self-service signup
# closes unless SOUNDBRIDGE_ALLOW_SIGNUP says otherwise. An https:// origin
# additionally turns on the HTTPS redirect, HSTS and Secure cookies, so use
# http:// while the site is still reached by IP address and port.
# SOUNDBRIDGE_PUBLIC_ORIGIN=http://13.51.0.0:8000
# SOUNDBRIDGE_SECRET_KEY=
# SOUNDBRIDGE_ALLOW_SIGNUP=true
# PORT=8000

# Email verification is off by default: a new account can sign in with the
# details it signed up with, and is marked verified at registration. Set this to
# true to put the confirmation step back.
SOUNDBRIDGE_REQUIRE_EMAIL_VERIFICATION=

# --- Database --------------------------------------------------------------
# Leave MYSQL_DATABASE empty for local SQLite. Production uses MySQL 8.0.16+.
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# --- Background work -------------------------------------------------------
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# Point this at the installed clamscan. Uploads stay quarantined without it.
SOUNDBRIDGE_MALWARE_SCANNER=

# --- Private files ---------------------------------------------------------
# A Fernet key; stored bytes are ciphertext with one set. A deployment with a
# public origin refuses to store an artifact without it. Losing it makes every
# existing artifact permanently unreadable.
SOUNDBRIDGE_PRIVATE_STORAGE_KEY=
# SOUNDBRIDGE_PRIVATE_STORAGE_ROOT=

# --- Identity and delivery -------------------------------------------------
# Use approved policy versions in production.
SOUNDBRIDGE_TERMS_VERSION=
SOUNDBRIDGE_PRIVACY_VERSION=
# The console backend prints mail to the log; never use it in production, where
# password recovery depends on real delivery.
SOUNDBRIDGE_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=SoundBridge <noreply@localhost>
